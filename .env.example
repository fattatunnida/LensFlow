# Default development mode uses local emulators. No Firebase account is needed.
EXPO_PUBLIC_FIREBASE_USE_EMULATORS=true
# Browser: 127.0.0.1; Android emulator: 10.0.2.2; phone: computer's LAN IPv4.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# Cloud: set USE_EMULATORS=false and fill every required field from Firebase's
# web app configuration. These identifiers are public, not Admin credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
